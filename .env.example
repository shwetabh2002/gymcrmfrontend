# Copy to `.env` for local development (`cp .env.example .env`).
# For production builds, use `.env.production` or set these on the host.
# NEVER commit real secrets — these are public NEXT_PUBLIC_* values only.

# Nest backend base URL (no trailing slash)
# Local API:  http://localhost:5000
# Live API:   https://gymcrm-api.axeera.com
NEXT_PUBLIC_API_BASE_URL=https://gymcrm-api.axeera.com

# Shown in the UI
NEXT_PUBLIC_APP_NAME=GymFlow
